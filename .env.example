# ── Tier 1 (in use) ─────────────────────────────────────────────────────────
# Full JDBC URL. Local docker-compose default shown; for Neon use e.g.
# jdbc:postgresql://ep-xxx.eu-central-1.aws.neon.tech/payflow?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/payflow
DATABASE_USER=payflow
DATABASE_PASSWORD=payflow

# ── Tier 2 (reserved, not read yet) ─────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_SECRET=generate-a-64-char-random-string
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
WEBHOOK_HMAC_SECRET=generate-a-random-string
AES_ENCRYPTION_KEY=base64-encoded-256-bit-key

# ── Tier 3 (reserved, not read yet) ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
