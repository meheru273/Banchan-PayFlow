# ── Database (both services) ────────────────────────────────────────────────
# Full JDBC URL. Local docker-compose default shown; for Neon use e.g.
# jdbc:postgresql://ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
# (Neon: use the DIRECT endpoint, not "-pooler" — Flyway breaks through PgBouncer)
DATABASE_URL=jdbc:postgresql://localhost:5432/payflow
DATABASE_USER=payflow
DATABASE_PASSWORD=payflow

# ── Messaging (both services) ───────────────────────────────────────────────
# Local docker-compose default shown; CloudAMQP gives amqps://user:pass@host/vhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# false = payment-service posts ledger entries in-process (no broker needed)
MESSAGING_ENABLED=true

# ── Security (payment-service) ──────────────────────────────────────────────
JWT_SECRET=generate-a-64-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PAYFLOW_ADMIN_USER=admin
PAYFLOW_ADMIN_PASSWORD=choose-an-admin-password
WEBHOOK_HMAC_SECRET=generate-a-random-string
WEBHOOK_TOLERANCE=5m

# ── Encryption at rest (both services) ──────────────────────────────────────
# Base64-encoded 256-bit key, or any string (SHA-256-derived to 256 bits)
AES_ENCRYPTION_KEY=generate-a-random-string

# ── Simulated provider (payment-service) ────────────────────────────────────
PROVIDER_WEBHOOK_DELAY=1500ms
# Defaults to this service's own /api/v1/webhooks/provider
PROVIDER_WEBHOOK_URL=

# ── Tier 3 (reserved, not read yet) ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
